NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Applaza

# Mapa base. CARTO exige clave desde el 25/09/2026 (gratis para uso no comercial):
# pedirla en https://carto.com/basemaps/apikey y restringirla al dominio de la app.
# Sin clave, el mapa usa OpenStreetMap como respaldo.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=

# Metricas de Migue en el dashboard de la Direccion de IA (Organizacion DIA).
# Opcional: sin clave y URL el asistente no reporta nada. Van solo en el servidor.
MIGUE_API_KEY=
MIGUE_DASHBOARD_URL=
# 1 = tambien manda la consulta que Migue no pudo responder (con correos y numeros tapados;
# los nombres de personas NO se tapan).
MIGUE_ENVIAR_PREGUNTAS=
